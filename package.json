{
  "name": "sisfia",
  "version": "5.2.0",
  "description": "SISFIA \u00b7 Sistema Financiero Administrativo",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:init": "node server/db.js --init",
    "db:seed": "node server/db.js --seed",
    "db:seed:full": "node server/seed-extended.js",
    "migrate:v2": "node scripts/migrate-v2-to-v3.js",
    "test:static": "node --test tests/static.test.cjs tests/finance-static.test.cjs tests/budget-static.test.cjs tests/cash-reconcile.test.cjs tests/provider-directory.test.cjs tests/dashboard-taxonomy.test.cjs tests/report-all-groups.test.cjs tests/monthly-detail.test.cjs tests/reconciliation.test.cjs tests/sunat-payment.test.cjs tests/import-balance.test.cjs tests/navigation.test.cjs",
    "test:documents": "python3 tests/finance_documents_test.py",
    "test:smart": "python3 tests/smart_import_test.py",
    "test:adaptive": "python3 tests/adaptive_import_test.py",
    "test:annex": "python3 tests/annex_import_test.py",
    "test:flow": "node --test tests/flow.test.cjs",
    "test:treasury": "node --test tests/treasury.test.cjs",
    "test:dates": "node --test tests/date-reconcile.test.cjs",
    "test:payroll": "node --test tests/security-payroll.test.cjs && python3 tests/payroll_documents_test.py",
    "test:storage": "node --test tests/storage-security.test.cjs",
    "test:erp": "node --test tests/erp.test.cjs",
    "test:daily": "node --test tests/daily.test.cjs && python3 tests/daily_documents_test.py"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
