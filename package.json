{
  "name": "sisfia",
  "version": "3.5.2",
  "description": "SISFIA · Sistema Financiero Administrativo",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:init": "node server/db.js --init",
    "db:seed": "node server/db.js --seed",
    "db:seed:full": "node server/seed-extended.js",
    "migrate:v2": "node scripts/migrate-v2-to-v3.js",
    "test:static": "node --test tests/static.test.cjs tests/finance-static.test.cjs",
    "test:documents": "python3 tests/finance_documents_test.py",
    "test:smart": "python3 tests/smart_import_test.py"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
